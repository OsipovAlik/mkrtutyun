# Owner page (/admin) login
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: separate secret for signing the login cookie (defaults to the credentials)
ADMIN_SESSION_SECRET=

# RSVP storage on Vercel: add "Upstash for Redis" from the Vercel Marketplace —
# it sets these automatically. Without them, answers go to data/rsvps.json (local only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional canonical URL for social previews (Vercel sets its own automatically).
NEXT_PUBLIC_SITE_URL=
